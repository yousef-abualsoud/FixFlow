<%- include('partials/header') %>
<%- include('partials/nav') %>

<%
    const statusClass = ticket.status === 'Resolved'
        ? 'bg-success'
        : ticket.status === 'In Progress'
            ? 'bg-primary'
            : 'bg-warning text-dark';
    const urgencyClass = ticket.urgency === 'High'
        ? 'bg-danger'
        : ticket.urgency === 'Medium'
            ? 'bg-warning text-dark'
            : 'bg-secondary';
%>

<main class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/services">Services</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ticket #<%= ticket.id %></li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="mb-1"><%= ticket.title %></h1>
            <p class="text-muted mb-0">Ticket #<%= ticket.id %> &middot; <%= ticket.category %></p>
        </div>
        <span class="badge fs-6 <%= statusClass %>"><%= ticket.status %></span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card p-4">
                <h2 class="h5 mb-3">Description</h2>
                <p class="mb-0"><%= ticket.description %></p>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card p-4">
                <h2 class="h5 mb-3">Ticket Details</h2>
                <dl class="row mb-0">
                    <dt class="col-5">Location</dt>
                    <dd class="col-7"><%= ticket.location %></dd>

                    <dt class="col-5">Category</dt>
                    <dd class="col-7"><%= ticket.category %></dd>

                    <dt class="col-5">Urgency</dt>
                    <dd class="col-7"><span class="badge <%= urgencyClass %>"><%= ticket.urgency %></span></dd>

                    <dt class="col-5">Status</dt>
                    <dd class="col-7"><span class="badge <%= statusClass %>"><%= ticket.status %></span></dd>
                </dl>
            </section>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a href="/services" class="btn btn-outline-primary">Back to Services</a>
        <a href="/" class="btn btn-outline-primary">Back to Home</a>
    </div>
</main>

<%- include('partials/footer') %>
